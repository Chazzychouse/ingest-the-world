{
  "realm": "ingest",
  "displayName": "Ingest the World (local dev)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "Reader", "description": "Search and view collections they are granted" },
      { "name": "Contributor", "description": "Upload and edit their own items" },
      { "name": "Curator", "description": "Edit any item in granted collections" },
      { "name": "Admin", "description": "Manage collections, grants and markings" },
      { "name": "Clearance.CUI", "description": "May read CUI-marked data" }
    ]
  },
  "clients": [
    {
      "clientId": "ingest-web",
      "name": "Ingest the World SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8081/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8081/*"
      },
      "protocolMappers": [
        {
          "name": "roles-as-top-level-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ingest-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Admin",
      "email": "alice@ingest.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["Admin", "Clearance.CUI"]
    },
    {
      "username": "carol",
      "firstName": "Carol",
      "lastName": "Contributor",
      "email": "carol@ingest.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "realmRoles": ["Contributor", "Clearance.CUI"]
    },
    {
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Reader",
      "email": "bob@ingest.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["Reader"]
    },
    {
      "username": "e2e",
      "firstName": "End-to-end",
      "lastName": "Suite",
      "email": "e2e@ingest.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "e2e", "temporary": false }],
      "realmRoles": ["Contributor", "Clearance.CUI"]
    }
  ]
}
