# Local stubs for what the platform reads and writes with pyarrow. Anything not declared here is
# Any: tests use it to write fixture files.
from collections.abc import Iterator, Mapping, Sequence
from typing import Any

class ArrowException(Exception): ...
class DataType: ...

class Field:
    name: str
    type: DataType
    def with_name(self, name: str) -> Field: ...

class Schema:
    metadata: dict[bytes, bytes] | None
    def __iter__(self) -> Iterator[Field]: ...
    def __len__(self) -> int: ...
    def with_metadata(self, metadata: Mapping[bytes, bytes]) -> Schema: ...

class Array: ...

class RecordBatch:
    num_rows: int
    columns: list[Array]
    @staticmethod
    def from_arrays(arrays: Sequence[Array], *, schema: Schema) -> RecordBatch: ...

class RecordBatchReader:
    schema: Schema
    def __iter__(self) -> Iterator[RecordBatch]: ...

def schema(fields: Sequence[Field], metadata: Mapping[bytes, bytes] | None = None) -> Schema: ...
def __getattr__(name: str) -> Any: ...
