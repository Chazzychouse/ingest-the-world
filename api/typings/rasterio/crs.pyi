class CRS:
    def to_epsg(self) -> int | None: ...
    def to_authority(self) -> tuple[str, str] | None: ...
    def to_wkt(self, morph_to_esri_dialect: bool = False, version: str | None = None) -> str: ...
    @classmethod
    def from_wkt(cls, wkt: str) -> CRS: ...
    @classmethod
    def from_epsg(cls, code: int) -> CRS: ...
    @classmethod
    def from_user_input(cls, value: str | CRS) -> CRS: ...
